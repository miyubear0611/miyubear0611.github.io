  function filterProfessors(professors) {
    const q = state.searchQuery.trim().toLowerCase();
    return professors.filter((p) => {
      if (state.tierFilter !== "all" && p.tier !== state.tierFilter) return false;
      if (state.uniFilter !== "all" && p.uniCode !== state.uniFilter) return false;
      if (state.quickFilter === "starred" && !state.starred.has(p.id)) return false;
      if (state.quickFilter === "english" && !(p.filterFlags && p.filterFlags.english)) return false;
      if (state.quickFilter === "pharm" && !(p.filterFlags && p.filterFlags.pharm)) return false;
      if (state.quickFilter === "fullSchol" && !(p.filterFlags && p.filterFlags.fullSchol)) return false;
      if (state.quickFilter === "intlRoster" && !(p.filterFlags && p.filterFlags.intlRoster)) return false;

      if (q) {
        const hay = [
          p.nameKr,
          p.nameOrig,
          p.displayName,
          p.roleTitle,
          p.affiliation,
          p.uniName,
          p.coreOutputs,
          p.pitchHighlight,
          p.email || "",
          ...(p.tags || []),
          ...(p.paragraphs || [])
        ]
          .join(" ")
          .toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

