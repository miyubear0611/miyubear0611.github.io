          <h2 class="section-title">${formatText(s6.title, lang)}</h2>
        </div>

        <h3 style="margin:0 0 0.9rem;font-size:1.14rem;color:var(--text-primary);">${formatText(s6.part1.title, lang)}</h3>

        <div class="consular-grid">
          ${(s6.part1.consularChain || [])
            .map(
              (cs) => `
              <div class="consular-step">
                <div class="consular-step-code">${esc(cs.step)}</div>
                <h4>${formatText(cs.title, lang)}</h4>
                <p>${formatText(cs.desc, lang)}</p>
              </div>
            `
            )
            .join("")}
        </div>

        <div class="dual-track-grid">
          ${(s6.part1.modes || [])
            .map(
              (m) => `
              <div class="track-card ${m.badgeTone === "emerald" ? "dry" : ""}" style="${
                m.badgeTone === "blue" ? "background:var(--blue-bg);border-color:var(--blue-border);" : ""
              }">
                <span class="track-tag" style="${
                  m.badgeTone === "blue" ? "background:rgba(2,132,199,0.14);color:var(--blue-text);" : ""
                }">${esc(m.code)}</span>
                <h4>${formatText(m.schools, lang)}</h4>
                <ul>
                  ${(m.points || []).map((pt) => `<li>${formatText(pt, lang)}</li>`).join("")}
                </ul>
              </div>
            `
            )
            .join("")}
        </div>

        <div class="prose-paragraphs">
          ${(s6.part1.paragraphs || []).map((p) => `<p class="prose-p">${formatText(p, lang)}</p>`).join("")}
        </div>

        <hr style="border:none;border-top:1px solid var(--border-color);margin:2rem 0;" />

        <!-- Interactive Gantt Schedule & Anti-Expiration Inspector -->
        <div id="sec-gantt" style="scroll-margin-top:5rem;">
          <h3 style="margin:0 0 0.6rem;font-size:1.14rem;color:var(--text-primary);">${formatText(s6.part2.title, lang)}</h3>
          <p class="prose-p" style="margin-bottom:1.1rem;">${formatText(s6.part2.lead, lang)}</p>

          <div class="vis-panel" style="margin-top:0;">
            <div class="vis-kicker">🗓️ ${esc(ui.ganttHint)}</div>
            <div class="gantt-scroll">
              <div class="gantt-board" dir="ltr">
                <div class="gantt-header-row">
                  <div style="padding:0.6rem 0.85rem;">Track / Schedule</div>
                  ${(gantt.months || [])
                    .map(
                      (m, idx) =>
                        `<div class="gantt-header-cell ${idx === gantt.milestoneCol ? "milestone" : ""}">${esc(m)}</div>`
                    )
                    .join("")}
                </div>

                ${(gantt.tracks || [])
                  .map(
                    (tr) => `
                    <div class="gantt-track-row ${state.activeGanttId === tr.id ? "active" : ""}" data-gantt-track="${esc(tr.id)}" tabindex="0">
                      <div class="gantt-track-info" dir="${lang === "fa" ? "rtl" : "ltr"}">
                        <div class="gantt-track-top">
                          <span class="gantt-code">${esc(tr.code)}</span>
                          <span class="gantt-track-title">${formatText(tr.title, lang)}</span>
                        </div>
                        <span class="gantt-mini-badge ${esc(tr.badgeTone)}">${formatText(tr.badge, lang)}</span>
                      </div>
                      <div class="gantt-timeline-cells">
                        ${(tr.bars || [])
                          .map(
                            (b) => `
                            <div
                              class="gantt-bar ${esc(b.type)}"
                              style="grid-column: ${Number(b.start) + 1} / span ${Number(b.span)};"
                              title="${esc(b.label)}"
                            >
                              ${esc(b.label)}
                            </div>
                          `
                          )
                          .join("")}
                      </div>
                    </div>
                  `
                  )
                  .join("")}
              </div>
            </div>

            <div class="gantt-inspector" id="ganttInspectorBox"></div>
          </div>
        </div>

        <!-- 9-Item Master Document Checklist -->
        <div id="sec-checklist" style="scroll-margin-top:5rem;">
          <div class="checklist-progress-box">
            <strong>✅ ${esc(ui.checklistProgressLabel)}</strong>
            <div class="progress-meter-wrap">
              <div class="progress-meter-bar">
                <div class="progress-meter-fill" id="checklistProgressFill" style="width:0%"></div>
              </div>
              <strong id="checklistProgressText" style="font-variant-numeric:tabular-nums;">0 / 9 (0%)</strong>
            </div>
            <button type="button" class="ctrl-btn print-btn" id="resetChecklistBtn">${esc(ui.checklistResetBtn)}</button>
          </div>

          <div class="table-scroll">
            <table class="clean-table">
              <thead>
                <tr>
                  ${(ui.checklistHeaders || []).map((th) => `<th>${esc(th)}</th>`).join("")}
                </tr>
              </thead>
              <tbody id="checklistTableBody"></tbody>
            </table>
          </div>
        </div>

        <div style="margin-top:1.75rem;text-align:center;">
          <button type="button" class="toc-cross-btn" style="display:inline-block;padding:0.8rem 1.6rem;font-size:0.95rem;border:none;cursor:pointer;font-family:inherit;" data-switch-view="main">
            ${esc(ui.backMainCta)}
          </button>
        </div>
      </section>
    `;

    renderScholRows(data);
    renderTimelineRows(data);
    renderGanttInspector(data);
    renderChecklistTable(data);

    const resetChecklistBtn = document.getElementById("resetChecklistBtn");
    if (resetChecklistBtn) {
      resetChecklistBtn.addEventListener("click", () => {
        state.checkedDocs.clear();
        saveCheckedDocs(state.checkedDocs);
        renderChecklistTable(getApplyData(state.lang));
      });
    }
  }

  /* ========================================================================
     SCROLL SPY & GLOBAL EVENT DELEGATION
     ======================================================================== */
  let observer = null;
  function setupScrollSpy() {
    if (observer) observer.disconnect();
    const links = Array.from(document.querySelectorAll(".toc-link"));
    const targets = links
      .map((a) => {
        const id = (a.getAttribute("href") || "").replace(/^#/, "");
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    if (!targets.length || !("IntersectionObserver" in window)) return;
    observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) {
          const id = visible[0].target.id;
          links.forEach((a) => {
            a.classList.toggle("active", a.getAttribute("href") === `#${id}`);
          });
        }
      },
      { rootMargin: "-15% 0px -70% 0px", threshold: 0.02 }
    );
    targets.forEach((t) => observer.observe(t));
  }

  function renderAll() {
    applyRootAttributes();
    if (state.view === "apply") {
      const applyData = getApplyData(state.lang);
      if (applyData) renderApplyView(applyData);
    } else {
      const mainData = getMainData(state.lang);
      if (mainData) renderMainView(mainData);
    }
    setupScrollSpy();
  }

  document.addEventListener("click", (e) => {
    const viewTabBtn = e.target.closest("[data-view-tab]");
    if (viewTabBtn) {
      const nextView = viewTabBtn.getAttribute("data-view-tab");
      if (nextView && nextView !== state.view) {
        switchView(nextView);
      }
      return;
    }

    const switchBtn = e.target.closest("[data-switch-view]");
    if (switchBtn) {
      const nextView = switchBtn.getAttribute("data-switch-view");
      const targetSec = switchBtn.getAttribute("data-target-sec") || "";
      switchView(nextView, targetSec);
      return;
    }

    const langBtn = e.target.closest(".lang-btn");
    if (langBtn) {
      const nextLang = langBtn.getAttribute("data-lang");
      if (nextLang && nextLang !== state.lang) {
        state.lang = nextLang;
        safeSetStorage(STORAGE_LANG, nextLang);
        syncUrlState();
        renderAll();
      }
      return;
    }

    const themeBtn = e.target.closest(".theme-btn");
    if (themeBtn) {
      state.theme = themeBtn.getAttribute("data-theme") || "light";
      safeSetStorage(STORAGE_THEME, state.theme);
      applyRootAttributes();
      return;
    }

    const sizeBtn = e.target.closest(".size-btn");
    if (sizeBtn) {
      state.size = sizeBtn.getAttribute("data-size") || "md";
      safeSetStorage(STORAGE_SIZE, state.size);
      applyRootAttributes();
      return;
    }

    if (e.target.closest("#printPageBtn")) {
      window.print();
      return;
    }

    const copyBtn = e.target.closest("[data-copy-email]");
    if (copyBtn) {
      const email = copyBtn.getAttribute("data-copy-email");
      const data = getActiveData();
      copyToClipboard(email, (data && data.ui && data.ui.copiedToast) || "Copied:");
      return;
    }

    const jumpProf = e.target.closest("[data-jump-prof]");
    if (jumpProf) {
      const pid = jumpProf.getAttribute("data-jump-prof");
      let card = document.getElementById(`prof-${pid}`);
      if (!card) {
        state.searchQuery = "";
        state.tierFilter = "all";
        state.uniFilter = "all";
        state.quickFilter = "all";
        const inp = document.getElementById("facultySearchInput");
        if (inp) inp.value = "";
        renderFacultyResultsIntoDOM(getMainData(state.lang));
        card = document.getElementById(`prof-${pid}`);
      }
      if (card) {
        card.scrollIntoView({ behavior: "smooth", block: "start" });
        card.classList.add("flash-highlight");
        setTimeout(() => card.classList.remove("flash-highlight"), 1800);
      }
      return;
    }

    const tierPill = e.target.closest("[data-tier-pill]");
    if (tierPill) {
      state.tierFilter = tierPill.getAttribute("data-tier-pill");
      renderFacultyResultsIntoDOM(getMainData(state.lang));
      return;
    }

    const uniPill = e.target.closest("[data-uni-pill]");
    if (uniPill) {
      state.uniFilter = uniPill.getAttribute("data-uni-pill");
      renderFacultyResultsIntoDOM(getMainData(state.lang));
      return;
    }

    const quickPill = e.target.closest("[data-quick-pill]");
    if (quickPill) {
      state.quickFilter = quickPill.getAttribute("data-quick-pill");
      renderFacultyResultsIntoDOM(getMainData(state.lang));
      return;
    }

    const starBtn = e.target.closest("[data-star-id]");
    if (starBtn) {
      const id = starBtn.getAttribute("data-star-id");
      if (state.starred.has(id)) {
        state.starred.delete(id);
      } else {
        state.starred.add(id);
      }
      saveStarredSet(state.starred);
      renderFacultyResultsIntoDOM(getMainData(state.lang));
      return;
    }

    const openMemo = e.target.closest("[data-open-memo]");
    if (openMemo) {
      const id = openMemo.getAttribute("data-open-memo");
      const box = document.getElementById(`hiddenMemo-${id}`);
      if (box) {
        box.style.display = "block";
        openMemo.style.display = "none";
        const ta = box.querySelector("textarea");
        if (ta) ta.focus();
      }
      return;
    }

    const scholCatBtn = e.target.closest("[data-schol-cat]");
    if (scholCatBtn) {
      state.scholCat = scholCatBtn.getAttribute("data-schol-cat");
      renderScholRows(getApplyData(state.lang));
      return;
    }

    const scholRow = e.target.closest("[data-schol-row]");
    if (scholRow) {
      const rid = scholRow.getAttribute("data-schol-row");
      state.activeScholId = state.activeScholId === rid ? null : rid;
      renderScholRows(getApplyData(state.lang));
      return;
    }

    const tlModeBtn = e.target.closest("[data-tl-mode]");
    if (tlModeBtn) {
      state.timelineMode = tlModeBtn.getAttribute("data-tl-mode");
      renderTimelineRows(getApplyData(state.lang));
      return;
    }

    const ganttRow = e.target.closest("[data-gantt-track]");
    if (ganttRow) {
      state.activeGanttId = ganttRow.getAttribute("data-gantt-track");
      renderGanttInspector(getApplyData(state.lang));
      return;
    }
  });

  document.addEventListener("mouseover", (e) => {
    if (state.view !== "apply") return;
    const ganttRow = e.target.closest("[data-gantt-track]");
    if (ganttRow) {
      const tid = ganttRow.getAttribute("data-gantt-track");
      if (tid && tid !== state.activeGanttId) {
        state.activeGanttId = tid;
        renderGanttInspector(getApplyData(state.lang));
      }
    }
  });

  document.addEventListener("input", (e) => {
    const memoTa = e.target.closest("[data-memo-input]");
    if (memoTa) {
      const id = memoTa.getAttribute("data-memo-input");
      safeSetStorage(STORAGE_MEMO_PREFIX + id, memoTa.value);
      const ind = document.getElementById(`memoInd-${id}`);
      if (ind) ind.style.opacity = "1";
    }
  });

  document.addEventListener("change", (e) => {
    const cb = e.target.closest("[data-doc-check]");
    if (cb) {
      const id = cb.getAttribute("data-doc-check");
      if (cb.checked) {
        state.checkedDocs.add(id);
      } else {
        state.checkedDocs.delete(id);
      }
      saveCheckedDocs(state.checkedDocs);
      renderChecklistTable(getApplyData(state.lang));
    }
  });

  window.addEventListener(
    "scroll",
    () => {
      const bar = document.getElementById("readingProgressBar");
      if (!bar) return;
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docH > 0 ? Math.min(100, Math.max(0, (window.scrollY / docH) * 100)) : 0;
      bar.style.width = `${pct}%`;
    },
    { passive: true }
  );

  renderAll();
})();

</script>
</body>
</html>
