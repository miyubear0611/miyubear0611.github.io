<!DOCTYPE html>
<html lang="zh-CN" dir="ltr" data-theme="light" data-size="md">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>韩国名校 2027 秋季纯干实验疫苗与 AI 生物药硕士全景执行门户</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Sans+KR:wght@500;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
/* ==========================================================================
   Korea 2027 Fall Pure Dry-Lab M.S. Execution Portal — Clean Refreshing UI
   Supports: 中文 (LTR) · English (LTR) · فارسی (RTL + Vazirmatn)
   ========================================================================== */

:root {
  --bg-canvas: #f5f8fb;
  --bg-surface: #ffffff;
  --bg-subtle: #f0f5fa;
  --bg-hover: #e8f1f9;
  --text-primary: #0f172a;
  --text-body: #1e293b;
  --text-secondary: #475569;
  --text-muted: #64748b;
  --border-color: #dbe4ee;
  --border-strong: #cbd5e1;

  --brand-primary: #0284c7;
  --brand-primary-dark: #0369a1;
  --brand-primary-soft: #e0f2fe;
  --brand-teal: #0d9488;
  --brand-teal-dark: #0f766e;
  --brand-teal-soft: #ccfbf1;
  --brand-mint-bg: #f0fdfa;

  --emerald-bg: #ecfdf5;
  --emerald-border: #a7f3d0;
  --emerald-text: #047857;
  --emerald-bar: #10b981;

  --blue-bg: #eff6ff;
  --blue-border: #bfdbfe;
  --blue-text: #1d4ed8;
  --blue-bar: #0284c7;

  --amber-bg: #fffbeb;
  --amber-border: #fde68a;
  --amber-text: #b45309;
  --amber-bar: #f59e0b;

  --rose-bg: #fef2f2;
  --rose-border: #fecdd3;
  --rose-text: #be123c;
  --rose-bar: #e11d48;

  --slate-bg: #f1f5f9;
  --slate-border: #cbd5e1;
  --slate-text: #334155;

  --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.03);
  --shadow-md: 0 4px 14px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.04);
  --shadow-lg: 0 12px 28px rgba(2, 132, 199, 0.09), 0 4px 10px rgba(15, 23, 42, 0.04);

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;

  --font-base-size: 16px;
  --font-sans-ltr: "Plus Jakarta Sans", "Noto Sans SC", "Noto Sans KR", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-sans-rtl: "Vazirmatn", "Noto Sans KR", "Plus Jakarta Sans", Tahoma, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

html[data-size="sm"] {
  --font-base-size: 14.5px;
}
html[data-size="md"] {
  --font-base-size: 16px;
}
html[data-size="lg"] {
  --font-base-size: 17.5px;
}

html[data-theme="sepia"] {
  --bg-canvas: #f8f4ec;
  --bg-surface: #fffdf8;
  --bg-subtle: #f2ece1;
  --bg-hover: #eae1d2;
  --text-primary: #1f1a14;
  --text-body: #2c251d;
  --text-secondary: #574c3f;
  --text-muted: #756858;
  --border-color: #e4dacb;
  --border-strong: #d3c5b0;
  --brand-mint-bg: #eef8f5;
}

html[data-theme="dark"] {
  --bg-canvas: #0b1120;
  --bg-surface: #111827;
  --bg-subtle: #1e293b;
  --bg-hover: #273549;
  --text-primary: #f8fafc;
  --text-body: #e2e8f0;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --border-color: #1f2937;
  --border-strong: #334155;

  --brand-primary: #38bdf8;
  --brand-primary-dark: #7dd3fc;
  --brand-primary-soft: rgba(56, 189, 248, 0.15);
  --brand-teal: #2dd4bf;
  --brand-teal-dark: #5eead4;
  --brand-teal-soft: rgba(45, 212, 191, 0.15);
  --brand-mint-bg: rgba(13, 148, 136, 0.12);

  --emerald-bg: rgba(16, 185, 129, 0.14);
  --emerald-border: rgba(16, 185, 129, 0.35);
  --emerald-text: #6ee7b7;

  --blue-bg: rgba(59, 130, 246, 0.14);
  --blue-border: rgba(59, 130, 246, 0.35);
  --blue-text: #93c5fd;

  --amber-bg: rgba(245, 158, 11, 0.14);
  --amber-border: rgba(245, 158, 11, 0.38);
  --amber-text: #fcd34d;

  --rose-bg: rgba(244, 63, 94, 0.14);
  --rose-border: rgba(244, 63, 94, 0.38);
  --rose-text: #fda4af;

  --slate-bg: #1e293b;
  --slate-border: #334155;
  --slate-text: #cbd5e1;

  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 12px 28px rgba(0, 0, 0, 0.45);
}

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  font-size: var(--font-base-size);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background-color: var(--bg-canvas);
  color: var(--text-body);
  font-family: var(--font-sans-ltr);
  line-height: 1.78;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

html[dir="rtl"] body {
  font-family: var(--font-sans-rtl);
  line-height: 1.9;
}

.ltr-token {
  direction: ltr;
  unicode-bidi: isolate;
  display: inline-block;
}

a {
  color: var(--brand-primary);
  text-decoration: none;
  transition: color 0.15s ease;
}
a:hover {
  color: var(--brand-primary-dark);
  text-decoration: underline;
}

/* Reading Progress Bar */
.reading-progress-track {
  position: fixed;
  top: 0;
  inset-inline: 0;
  height: 3px;
  background: transparent;
  z-index: 200;
}
.reading-progress-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--brand-primary), var(--brand-teal));
  transition: width 0.1s linear;
}

/* Sticky Top Navigation */
.topbar {
  position: sticky;
  top: 0;
  z-index: 150;
  background: color-mix(in srgb, var(--bg-surface) 92%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
}

.topbar-inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0.65rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.85rem;
  flex-wrap: wrap;
}

.brand-cluster {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 0;
}

.brand-pill {
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-teal));
  color: #ffffff;
  font-weight: 800;
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  padding: 0.28rem 0.6rem;
  border-radius: 6px;
  white-space: nowrap;
}

.brand-title {
  font-weight: 700;
  font-size: 0.94rem;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 360px;
}

/* Page Switcher Tabs (Main Page <-> Application Page) */
.page-nav-tabs {
  display: inline-flex;
  align-items: center;
  background: var(--bg-subtle);
  padding: 0.22rem;
  border-radius: 10px;
  border: 1px solid var(--border-color);
  gap: 0.22rem;
}

.page-tab-link {
  display: inline-flex;
  align-items: center;
  gap: 0.38rem;
  padding: 0.38rem 0.82rem;
  border-radius: 7px;
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.16s ease;
  white-space: nowrap;
}
.page-tab-link:hover {
  color: var(--text-primary);
  background: var(--bg-hover);
  text-decoration: none;
}
.page-tab-link.active {
  background: var(--bg-surface);
  color: var(--brand-primary);
  box-shadow: var(--shadow-sm);
  font-weight: 700;
}

/* Right Controls & Language Switcher */
.controls-cluster {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.ctrl-seg {
  display: inline-flex;
  background: var(--bg-subtle);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 0.16rem;
  gap: 0.12rem;
}

.ctrl-btn {
  border: none;
  background: transparent;
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 0.28rem 0.55rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
}
.ctrl-btn:hover {
  color: var(--text-primary);
  background: var(--bg-hover);
}
.ctrl-btn.active {
  background: var(--bg-surface);
  color: var(--brand-primary);
  box-shadow: var(--shadow-sm);
  font-weight: 700;
}

.print-btn {
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  padding: 0.34rem 0.68rem;
  border-radius: 8px;
}

.lang-switcher {
  display: inline-flex;
  background: var(--brand-primary-soft);
  border: 1px solid color-mix(in srgb, var(--brand-primary) 28%, transparent);
  border-radius: 9px;
  padding: 0.18rem;
  gap: 0.18rem;
}

.lang-btn {
  border: none;
  background: transparent;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  padding: 0.3rem 0.68rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
}
.lang-btn:hover {
  background: color-mix(in srgb, var(--bg-surface) 60%, transparent);
}
.lang-btn.active {
  background: var(--brand-primary);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 1px 4px rgba(2, 132, 199, 0.3);
}

/* Main Layout Grid */
.portal-shell {
  max-width: 1440px;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 4rem;
  display: grid;
  grid-template-columns: 235px minmax(0, 1fr);
  gap: 1.75rem;
  align-items: start;
}

.toc-sidebar {
  position: sticky;
  top: 4.5rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1rem 0.85rem;
  box-shadow: var(--shadow-sm);
  max-height: calc(100vh - 5.5rem);
  overflow-y: auto;
}

.toc-heading {
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  padding: 0 0.55rem 0.55rem;
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 0.55rem;
}

.toc-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.22rem;
}

.toc-link {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.46rem 0.6rem;
  border-radius: 8px;
  font-size: 0.84rem;
  font-weight: 500;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.14s ease;
}
.toc-link:hover {
  background: var(--bg-subtle);
  color: var(--text-primary);
  text-decoration: none;
}
.toc-link.active {
  background: var(--brand-primary-soft);
  color: var(--brand-primary-dark);
  font-weight: 700;
}

.toc-cross-btn {
  margin-top: 0.85rem;
  display: block;
  text-align: center;
  padding: 0.6rem 0.7rem;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-teal));
  color: #ffffff !important;
  font-size: 0.8rem;
  font-weight: 700;
  line-height: 1.4;
  text-decoration: none !important;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.toc-cross-btn:hover {
  transform: translateY(-1px);
  opacity: 0.95;
}

.portal-main {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  min-width: 0;
}

/* Hero Card */
.hero-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  padding: 2rem 2.1rem;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}
.hero-card::before {
  content: "";
  position: absolute;
  top: 0;
  inset-inline: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--brand-primary), var(--brand-teal), #38bdf8);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--brand-mint-bg);
  color: var(--brand-teal-dark);
  border: 1px solid color-mix(in srgb, var(--brand-teal) 28%, transparent);
  padding: 0.3rem 0.78rem;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 0.85rem;
}

.hero-title {
  margin: 0 0 1rem;
  font-size: clamp(1.45rem, 2.3vw, 2rem);
  line-height: 1.32;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.015em;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-bottom: 1.15rem;
}

.profile-tag {
  background: var(--bg-subtle);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.26rem 0.68rem;
  border-radius: 7px;
}

.hero-lead {
  margin: 0 0 1.4rem;
  font-size: 0.98rem;
  color: var(--text-body);
  background: var(--bg-subtle);
  border-inline-start: 3.5px solid var(--brand-primary);
  padding: 0.95rem 1.15rem;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}
html[dir="rtl"] .hero-lead {
  border-radius: var(--radius-sm) 0 0 var(--radius-sm);
}

/* KPI Strip */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.9rem;
  margin-bottom: 1.5rem;
}

.kpi-box {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 0.95rem 1rem;
  transition: border-color 0.15s ease, transform 0.15s ease;
}
.kpi-box:hover {
  border-color: var(--brand-primary);
  transform: translateY(-1px);
}
.kpi-val {
  font-size: 1.38rem;
  font-weight: 800;
  color: var(--brand-primary);
  line-height: 1.2;
  margin-bottom: 0.25rem;
  font-variant-numeric: tabular-nums;
}
.kpi-label {
  font-size: 0.86rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.2rem;
}
.kpi-sub {
  font-size: 0.76rem;
  color: var(--text-muted);
  line-height: 1.42;
}

/* Core Conclusions Stack */
.conclusions-grid {
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
}

.conclusion-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.15rem 1.3rem;
  box-shadow: var(--shadow-sm);
}
.conclusion-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.5rem;
  flex-wrap: wrap;
}
.conclusion-num {
  background: var(--blue-bg);
  color: var(--blue-text);
  border: 1px solid var(--blue-border);
  font-size: 0.75rem;
  font-weight: 800;
  padding: 0.16rem 0.55rem;
  border-radius: 6px;
}
.conclusion-title {
  margin: 0;
  font-size: 1.02rem;
  font-weight: 700;
  color: var(--text-primary);
}
.conclusion-text {
  margin: 0;
  font-size: 0.95rem;
  color: var(--text-body);
}
.conclusion-cta {
  display: inline-flex;
  align-items: center;
  margin-top: 0.65rem;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--brand-teal);
}

/* Section Card Container */
.section-block {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  padding: 1.85rem 2rem;
  box-shadow: var(--shadow-md);
  scroll-margin-top: 5rem;
}

.section-head {
  margin-bottom: 1.35rem;
  padding-bottom: 0.95rem;
  border-bottom: 1px solid var(--border-color);
}
.section-kicker {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--brand-teal);
  background: var(--brand-mint-bg);
  border: 1px solid color-mix(in srgb, var(--brand-teal) 25%, transparent);
  padding: 0.18rem 0.6rem;
  border-radius: 6px;
  margin-bottom: 0.45rem;
}
.section-title {
  margin: 0;
  font-size: clamp(1.22rem, 1.8vw, 1.52rem);
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.35;
}
.section-subtitle {
  margin: 0.4rem 0 0;
  font-size: 0.92rem;
  color: var(--text-secondary);
}

.prose-paragraphs {
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
  margin-top: 1.15rem;
}
.prose-p {
  margin: 0;
  font-size: 0.97rem;
  color: var(--text-body);
  text-align: justify;
}

/* Survey Cards & Metric Bars (Section 1) */
.surveys-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin-bottom: 1.25rem;
}
.survey-card {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.1rem 1.15rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.survey-badge {
  font-size: 0.73rem;
  font-weight: 700;
  color: var(--brand-primary);
}
.survey-title {
  margin: 0;
  font-size: 0.94rem;
  font-weight: 700;
  color: var(--text-primary);
}
.survey-metric {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.survey-metric-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.5rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-body);
}
.survey-metric-val {
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.survey-bar-track {
  height: 7px;
  background: var(--border-color);
  border-radius: 999px;
  overflow: hidden;
}
.survey-bar-fill {
  height: 100%;
  border-radius: 999px;
}
.tone-rose { background: var(--rose-bar); color: var(--rose-text); }
.tone-amber { background: var(--amber-bar); color: var(--amber-text); }
.tone-emerald { background: var(--emerald-bar); color: var(--emerald-text); }
.tone-blue { background: var(--blue-bar); color: var(--blue-text); }
.tone-slate { background: #64748b; color: var(--slate-text); }
.survey-metric-sub {
  font-size: 0.74rem;
  color: var(--text-muted);
}

/* Dual Track Comparison */
.dual-track-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  margin-bottom: 1.25rem;
}
.track-card {
  border-radius: var(--radius-md);
  padding: 1.15rem 1.25rem;
  border: 1px solid var(--border-color);
}
.track-card.wet {
  background: var(--rose-bg);
  border-color: var(--rose-border);
}
.track-card.dry {
  background: var(--emerald-bg);
  border-color: var(--emerald-border);
}
.track-tag {
  display: inline-block;
  font-size: 0.73rem;
  font-weight: 800;
  padding: 0.15rem 0.55rem;
  border-radius: 5px;
  margin-bottom: 0.45rem;
}
.track-card.wet .track-tag {
  background: rgba(225, 29, 72, 0.12);
  color: var(--rose-text);
}
.track-card.dry .track-tag {
  background: rgba(16, 185, 129, 0.15);
  color: var(--emerald-text);
}
.track-card h4 {
  margin: 0 0 0.55rem;
  font-size: 1rem;
  color: var(--text-primary);
}
.track-card ul {
  margin: 0;
  padding-inline-start: 1.15rem;
  font-size: 0.88rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

/* Visualization Panel (Iframe 0 & Iframe 1 Upgraded Native Charts) */
.vis-panel {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.35rem 1.45rem;
  margin: 1.25rem 0 1.6rem;
}
.vis-kicker {
  font-size: 0.76rem;
  font-weight: 800;
  color: var(--brand-primary);
  margin-bottom: 0.3rem;
}
.vis-title {
  margin: 0 0 0.3rem;
  font-size: 1.08rem;
  font-weight: 800;
  color: var(--text-primary);
}
.vis-sub {
  margin: 0 0 0.9rem;
  font-size: 0.84rem;
  color: var(--text-secondary);
}
.vis-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 0.95rem;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
}
.legend-dot {
  display: inline-block;
  width: 11px;
  height: 11px;
  border-radius: 3px;
  margin-inline-end: 0.38rem;
  vertical-align: middle;
}

.roster-rows {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.roster-row {
  display: grid;
  grid-template-columns: 220px minmax(180px, 1fr) 260px;
  gap: 0.9rem;
  align-items: center;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 0.62rem 0.85rem;
  cursor: pointer;
  transition: all 0.15s ease;
}
.roster-row:hover {
  border-color: var(--brand-primary);
  box-shadow: var(--shadow-sm);
  transform: translateX(2px);
}
html[dir="rtl"] .roster-row:hover {
  transform: translateX(-2px);
}
.roster-pi {
  font-weight: 700;
  font-size: 0.87rem;
  color: var(--text-primary);
}
.roster-affil {
  display: block;
  font-size: 0.75rem;
  color: var(--text-muted);
}
.roster-bars {
  display: flex;
  flex-direction: column;
  gap: 0.28rem;
}
.bar-line {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}
.bar-fill-ms {
  height: 10px;
  background: var(--brand-primary);
  border-radius: 4px;
  min-width: 3px;
}
.bar-fill-intl {
  height: 10px;
  background: var(--brand-teal);
  border-radius: 4px;
  min-width: 3px;
}
.bar-num {
  font-size: 0.77rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.roster-note {
  font-size: 0.8rem;
  color: var(--text-secondary);
}
.vis-footnote {
  margin: 0.85rem 0 0;
  font-size: 0.76rem;
  color: var(--text-muted);
  line-height: 1.55;
}

/* Filter Toolbar (Section 2) */
.filter-toolbar {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.15rem 1.25rem;
  margin-bottom: 1.35rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}
.search-row {
  display: flex;
  gap: 0.65rem;
  flex-wrap: wrap;
  align-items: center;
}
.search-input-wrap {
  flex: 1 1 300px;
  position: relative;
}
.search-input {
  width: 100%;
  padding: 0.62rem 0.95rem;
  border-radius: 10px;
  border: 1px solid var(--border-strong);
  background: var(--bg-surface);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.9rem;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.search-input:focus {
  border-color: var(--brand-primary);
  box-shadow: 0 0 0 3px var(--brand-primary-soft);
}

.filter-group-row {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
}
.filter-group-label {
  font-size: 0.78rem;
  font-weight: 800;
  color: var(--text-muted);
  margin-inline-end: 0.25rem;
}
.pill-btn {
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.14s ease;
}
.pill-btn:hover {
  border-color: var(--brand-primary);
  color: var(--brand-primary);
}
.pill-btn.active {
  background: var(--brand-primary);
  border-color: var(--brand-primary);
  color: #ffffff;
}
.pill-btn.reserved-pill.active {
  background: var(--brand-teal);
  border-color: var(--brand-teal);
}

.filter-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.6rem;
  padding-top: 0.45rem;
  border-top: 1px dashed var(--border-color);
  font-size: 0.83rem;
  color: var(--text-secondary);
}

/* Responsive Data Tables */
.table-scroll {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: var(--bg-surface);
  margin-bottom: 1.5rem;
}
.clean-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.86rem;
  min-width: 780px;
}
.clean-table th {
  background: var(--bg-subtle);
  color: var(--text-primary);
  font-weight: 700;
  text-align: start;
  padding: 0.78rem 0.9rem;
  border-bottom: 1px solid var(--border-strong);
  white-space: nowrap;
}
.clean-table td {
  padding: 0.78rem 0.9rem;
  border-bottom: 1px solid var(--border-color);
  vertical-align: top;
  color: var(--text-body);
}
.clean-table tr:last-child td {
  border-bottom: none;
}
.clean-table tbody tr:hover {
  background: var(--bg-canvas);
}
.clean-table tr.reserved-table-row {
  background: var(--brand-mint-bg);
}

/* Professor Deep-Dive Cards */
.prof-cards-stack {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.prof-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.45rem 1.6rem;
  box-shadow: var(--shadow-sm);
  scroll-margin-top: 5.5rem;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}
.prof-card:hover {
  box-shadow: var(--shadow-md);
}
.prof-card.reserved-seat {
  border: 2px solid var(--brand-teal);
  background: linear-gradient(180deg, var(--brand-mint-bg) 0%, var(--bg-surface) 160px);
  box-shadow: var(--shadow-lg);
}
.prof-card.flash-highlight {
  outline: 3px solid var(--brand-primary);
  outline-offset: 2px;
}

.prof-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.9rem;
  flex-wrap: wrap;
  margin-bottom: 0.65rem;
}
.prof-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.42rem;
  align-items: center;
}

.tier-badge {
  font-size: 0.74rem;
  font-weight: 800;
  padding: 0.2rem 0.58rem;
  border-radius: 6px;
}
.tier-reserved {
  background: var(--brand-teal);
  color: #ffffff;
}
.tier-golden {
  background: var(--blue-bg);
  color: var(--blue-text);
  border: 1px solid var(--blue-border);
}
.tier-high_output {
  background: var(--emerald-bg);
  color: var(--emerald-text);
  border: 1px solid var(--emerald-border);
}
.tier-top_reach {
  background: var(--amber-bg);
  color: var(--amber-text);
  border: 1px solid var(--amber-border);
}
.tier-upstream {
  background: var(--slate-bg);
  color: var(--slate-text);
  border: 1px solid var(--slate-border);
}

.uni-badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.18rem 0.55rem;
  border-radius: 6px;
  background: var(--bg-subtle);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.foreign-badge {
  font-size: 0.73rem;
  font-weight: 700;
  padding: 0.18rem 0.55rem;
  border-radius: 6px;
  background: var(--emerald-bg);
  color: var(--emerald-text);
  border: 1px solid var(--emerald-border);
}

.star-btn {
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 0.28rem 0.65rem;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.star-btn.starred {
  background: var(--amber-bg);
  border-color: var(--amber-border);
  color: var(--amber-text);
}

.prof-name-heading {
  margin: 0 0 0.25rem;
  font-size: 1.24rem;
  font-weight: 800;
  color: var(--text-primary);
}
.prof-role-affil {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--brand-primary);
  margin-bottom: 0.75rem;
}

.prof-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.38rem;
  margin-bottom: 0.85rem;
}
.prof-tag {
  font-size: 0.76rem;
  font-weight: 600;
  background: var(--bg-subtle);
  color: var(--text-secondary);
  padding: 0.18rem 0.55rem;
  border-radius: 6px;
}

.prof-outputs-strip {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0.62rem 0.85rem;
  font-size: 0.86rem;
  margin-bottom: 0.9rem;
  color: var(--text-body);
}

.prof-pitch-box {
  margin-top: 0.95rem;
  background: var(--brand-mint-bg);
  border: 1px solid color-mix(in srgb, var(--brand-teal) 30%, transparent);
  border-inline-start: 4px solid var(--brand-teal);
  border-radius: var(--radius-sm);
  padding: 0.78rem 1rem;
  font-size: 0.89rem;
  color: var(--text-primary);
}

.memo-box {
  margin-top: 0.95rem;
  background: var(--bg-surface);
  border: 1px dashed var(--brand-teal);
  border-radius: var(--radius-sm);
  padding: 0.8rem 0.95rem;
}
.memo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--brand-teal-dark);
  margin-bottom: 0.45rem;
}
.memo-textarea {
  width: 100%;
  min-height: 76px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 0.55rem 0.75rem;
  font-family: inherit;
  font-size: 0.86rem;
  background: var(--bg-canvas);
  color: var(--text-primary);
  resize: vertical;
}
.memo-textarea:focus {
  outline: none;
  border-color: var(--brand-teal);
}

.prof-links-footer {
  margin-top: 1rem;
  padding-top: 0.85rem;
  border-top: 1px solid var(--border-color);
  display: flex;
  flex-wrap: wrap;
  gap: 0.48rem;
  align-items: center;
}

.email-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--blue-bg);
  border: 1px solid var(--blue-border);
  color: var(--blue-text);
  font-family: var(--font-mono);
  font-size: 0.79rem;
  font-weight: 600;
  padding: 0.28rem 0.65rem;
  border-radius: 7px;
  cursor: pointer;
}
.email-chip:hover {
  opacity: 0.9;
}

.ext-link-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: var(--bg-subtle);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-size: 0.78rem;
  font-weight: 600;
  padding: 0.26rem 0.62rem;
  border-radius: 7px;
  text-decoration: none;
}
.ext-link-chip:hover {
  border-color: var(--brand-primary);
  color: var(--brand-primary);
  text-decoration: none;
}

/* Career & Visa Stepper (Section 3) */
.iau-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.85rem;
  margin: 1rem 0 1.25rem;
}
.iau-card {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0.85rem 1rem;
}
.iau-uni {
  font-size: 0.84rem;
  font-weight: 800;
  color: var(--brand-primary);
  margin-bottom: 0.22rem;
}
.iau-detail {
  font-size: 0.86rem;
  color: var(--text-body);
}

.visa-stepper {
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
  margin-top: 1.1rem;
}
.visa-stage-card {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-inline-start: 4px solid var(--brand-primary);
  border-radius: var(--radius-md);
  padding: 1.15rem 1.3rem;
}
.visa-stage-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.45rem;
}
.visa-code {
  background: var(--brand-primary);
  color: #ffffff;
  font-size: 0.74rem;
  font-weight: 800;
  padding: 0.18rem 0.58rem;
  border-radius: 6px;
}
.visa-name {
  margin: 0;
  font-size: 1.02rem;
  font-weight: 800;
  color: var(--text-primary);
}
.visa-highlight {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--brand-teal-dark);
  background: var(--brand-mint-bg);
  padding: 0.35rem 0.68rem;
  border-radius: 6px;
  margin-bottom: 0.65rem;
  display: inline-block;
}

/* Application Page Specific: Redline Cards, Scholarship Bars, Interactive Gantt, Checklist */
.redlines-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.9rem;
}
.redline-card {
  background: var(--rose-bg);
  border: 1px solid var(--rose-border);
  border-radius: var(--radius-md);
  padding: 0.95rem 1.05rem;
}
.redline-tag {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  color: var(--rose-text);
  background: rgba(225, 29, 72, 0.1);
  padding: 0.14rem 0.5rem;
  border-radius: 5px;
  margin-bottom: 0.38rem;
}
.redline-title {
  margin: 0 0 0.3rem;
  font-size: 0.93rem;
  font-weight: 800;
  color: var(--text-primary);
}
.redline-desc {
  margin: 0;
  font-size: 0.8rem;
  color: var(--text-secondary);
  line-height: 1.48;
}

/* Scholarship Comparison Bar Chart */
.schol-rows {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.schol-row {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 0.78rem 0.95rem;
  cursor: pointer;
  transition: all 0.15s ease;
}
.schol-row:hover, .schol-row.active {
  border-color: var(--brand-primary);
  box-shadow: var(--shadow-sm);
}
.schol-row-grid {
  display: grid;
  grid-template-columns: 220px minmax(170px, 260px) minmax(0, 1fr);
  gap: 0.95rem;
  align-items: center;
}
.schol-school {
  font-weight: 800;
  font-size: 0.9rem;
  color: var(--text-primary);
}
.schol-prog {
  font-size: 0.77rem;
  color: var(--text-muted);
}
.schol-bar-wrap {
  background: var(--bg-subtle);
  border-radius: 7px;
  height: 26px;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--border-color);
}
.schol-bar-fill {
  height: 100%;
  border-radius: 6px;
  transition: width 0.3s ease;
}
.schol-bar-fill.emerald { background: #34d399; }
.schol-bar-fill.blue { background: #38bdf8; }
.schol-bar-fill.amber { background: #fbbf24; }
.schol-bar-fill.rose { background: #fb7185; }
.schol-bar-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  padding: 0 0.6rem;
  font-size: 0.75rem;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}
html[data-theme="dark"] .schol-bar-label {
  color: #f8fafc;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
}
.schol-rule {
  font-size: 0.83rem;
  color: var(--text-body);
}
.schol-detail-drawer {
  margin-top: 0.6rem;
  padding-top: 0.55rem;
  border-top: 1px dashed var(--border-color);
  font-size: 0.83rem;
  color: var(--brand-teal-dark);
  display: none;
}
.schol-row.active .schol-detail-drawer {
  display: block;
}

.boosters-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.85rem;
  margin: 1.15rem 0;
}
.booster-card {
  background: var(--brand-mint-bg);
  border: 1px solid color-mix(in srgb, var(--brand-teal) 26%, transparent);
  border-radius: var(--radius-md);
  padding: 0.9rem 1rem;
}
.booster-num {
  font-size: 0.73rem;
  font-weight: 800;
  color: var(--brand-teal);
  margin-bottom: 0.25rem;
}
.booster-title {
  font-size: 0.89rem;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 0.3rem;
}
.booster-desc {
  font-size: 0.8rem;
  color: var(--text-secondary);
  margin: 0;
}

/* Consular Chain Cards */
.consular-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.85rem;
  margin-bottom: 1.2rem;
}
.consular-step {
  background: var(--bg-canvas);
  border: 1px solid var(--border-color);
  border-top: 3px solid var(--brand-primary);
  border-radius: var(--radius-md);
  padding: 0.95rem 1rem;
}
.consular-step-code {
  font-size: 0.72rem;
  font-weight: 800;
  color: var(--brand-primary);
  margin-bottom: 0.25rem;
}
.consular-step h4 {
  margin: 0 0 0.35rem;
  font-size: 0.92rem;
  color: var(--text-primary);
}
.consular-step p {
  margin: 0;
  font-size: 0.82rem;
  color: var(--text-secondary);
}

/* Interactive Gantt Schedule (Iframe 2 Upgraded Native Widget) */
.gantt-scroll {
  width: 100%;
  overflow-x: auto;
}
.gantt-board {
  min-width: 820px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: var(--bg-surface);
  overflow: hidden;
}
.gantt-header-row {
  display: grid;
  grid-template-columns: 270px repeat(11, minmax(46px, 1fr));
  background: var(--bg-subtle);
  border-bottom: 1px solid var(--border-strong);
  font-size: 0.76rem;
  font-weight: 800;
  color: var(--text-secondary);
}
.gantt-header-cell {
  padding: 0.6rem 0.35rem;
  text-align: center;
  border-inline-start: 1px solid var(--border-color);
}
.gantt-header-cell.milestone {
  background: var(--blue-bg);
  color: var(--blue-text);
}
.gantt-track-row {
  display: grid;
  grid-template-columns: 270px minmax(0, 1fr);
  border-bottom: 1px solid var(--border-color);
  cursor: pointer;
  transition: background 0.14s ease;
}
.gantt-track-row:last-child {
  border-bottom: none;
}
.gantt-track-row:hover, .gantt-track-row.active {
  background: var(--blue-bg);
}
.gantt-track-info {
  padding: 0.72rem 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.gantt-track-top {
  display: flex;
  align-items: flex-start;
  gap: 0.45rem;
}
.gantt-code {
  background: var(--bg-subtle);
  border: 1px solid var(--border-strong);
  font-size: 0.72rem;
  font-weight: 800;
  padding: 0.1rem 0.4rem;
  border-radius: 5px;
  color: var(--text-primary);
  flex-shrink: 0;
}
.gantt-track-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.38;
}
.gantt-mini-badge {
  align-self: flex-start;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.1rem 0.48rem;
  border-radius: 5px;
}
.gantt-mini-badge.rose { background: var(--rose-bg); color: var(--rose-text); border: 1px solid var(--rose-border); }
.gantt-mini-badge.blue { background: var(--blue-bg); color: var(--blue-text); border: 1px solid var(--blue-border); }
.gantt-mini-badge.emerald { background: var(--emerald-bg); color: var(--emerald-text); border: 1px solid var(--emerald-border); }

.gantt-timeline-cells {
  display: grid;
  grid-template-columns: repeat(11, minmax(46px, 1fr));
  align-items: center;
  padding: 0.5rem 0;
  position: relative;
  border-inline-start: 1px solid var(--border-color);
  background-image: repeating-linear-gradient(
    to right,
    transparent,
    transparent calc(100% / 11 - 1px),
    var(--border-color) calc(100% / 11 - 1px),
    var(--border-color) calc(100% / 11)
  );
}
.gantt-bar {
  margin: 0.14rem 3px;
  padding: 0.28rem 0.45rem;
  border-radius: 6px;
  font-size: 0.72rem;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
